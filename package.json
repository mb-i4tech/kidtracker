{
  "name": "kid-tracker",
  "version": "2.1.0",
  "description": "Kid Smart Watch Tracker Application",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:index": "browserify -p tinyify src/main/js/app.js -o src/main/resources/static/js/index.js",
    "clean": "npm-run-all clean:*",
    "clean:index": "rimraf src/main/resources/static/js/index.js",
    "start": "npm run clean && npm run build",
    "test": "node --test tests/*.test.cjs && node tests/device-dom-regression.cjs",
    "lint": "eslint src/main/js",
    "test:browser": "playwright test",
    "build:vendor": "node scripts/vendor-assets.cjs"
  },
  "dependencies": {
    "block-ui": "2.70.1",
    "bootstrap-icons": "^1.0.0-alpha5",
    "bootstrap-input-spinner": "^1.13.9",
    "chart.js": "^2.9.3",
    "gijgo": "1.9.14",
    "jquery-ui": "^1.12.1",
    "leaflet": "1.9.4",
    "moment": "^2.26.0",
    "sockjs-client": "1.6.1",
    "stompjs": "2.3.3"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "bootstrap": "4.6.2",
    "browserify": "17.0.1",
    "copyfiles": "^1.2.0",
    "eslint": "8.57.1",
    "jquery": "3.7.1",
    "jsdom": "24.1.3",
    "npm-run-all": "^4.0.2",
    "rimraf": "^2.6.1",
    "tinyify": "4.0.0"
  },
  "overrides": {
    "crypto-browserify": "3.12.1",
    "tinyify": {
      "terser": "4.8.1"
    }
  }
}
